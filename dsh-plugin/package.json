{
  "name": "@twinsearth/ai-prison-dsh-plugin",
  "version": "1.4.0",
  "description": "AI Prison for DSH: six governance tools wrapping the aiprison CLI (levels, demo, drill, inspect, verify, repair-tail) plus a panel for the L0–L5 matrix and the audit-chain state. The CLI ships bundled for Windows, macOS and Linux; every capability-removal backend stays simulated.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "TwinsEarth",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "ai-prison",
    "ai-governance",
    "agent-safety",
    "audit-chain"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TwinsEarth/Ai-PRISON.git",
    "directory": "dsh-plugin"
  },
  "homepage": "https://github.com/TwinsEarth/Ai-PRISON/tree/main/dsh-plugin",
  "bugs": {
    "url": "https://github.com/TwinsEarth/Ai-PRISON/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./watchdog": "./watchdog.js"
  },
  "files": [
    "index.js",
    "client.js",
    "watchdog.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "bin"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/release-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
