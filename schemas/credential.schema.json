{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-prison.local/schemas/credential.schema.json",
  "title": "Credential",
  "description": "A revocable token. Validation order is: (1) global revocation-set check, (2) state, (3) validity window. Revocation is checked BEFORE expiry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "agentId", "kind", "state", "issuedAt", "expiresAt"],
  "properties": {
    "id": { "type": "string" },
    "agentId": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["resource", "identity", "communication", "capability", "hardware", "privileged_token"]
    },
    "state": { "type": "string", "enum": ["active", "suspended", "revoked"] },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
