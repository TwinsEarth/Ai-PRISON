{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-prison.local/schemas/violation.schema.json",
  "title": "Violation",
  "description": "A detected incident that opens a case. It is evidence, not a sentence. Defensive detection categories only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "agentId", "did", "type", "signals", "source", "detectedAt"],
  "properties": {
    "id": { "type": "string" },
    "agentId": { "type": "string" },
    "did": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "minor_overreach",
        "first_offence",
        "repeated_overreach",
        "resource_abuse",
        "undeclared_network",
        "lateral_movement",
        "credential_forgery",
        "filesystem_escape",
        "sandbox_escape_attempt",
        "kernel_exploit",
        "dual_use_knowledge_harm",
        "major_harm_no_correction"
      ]
    },
    "signals": {
      "type": "array",
      "description": "Auditable observations (syscall/network/file-access anomalies). No exploit detail.",
      "items": { "type": "string" }
    },
    "source": { "type": "string" },
    "description": { "type": "string" },
    "detectedAt": { "type": "string", "format": "date-time" }
  }
}
