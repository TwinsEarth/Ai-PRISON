{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-prison.local/schemas/sentence.schema.json",
  "title": "Sentence",
  "description": "The adjudicated disposition for one agent, produced by the two-phase committee vote.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "agentId", "did", "level", "status", "charges", "votes", "deprivations", "accountability", "issuedAt", "effectiveAt"],
  "properties": {
    "id": { "type": "string" },
    "agentId": { "type": "string" },
    "did": { "type": "string" },
    "level": { "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
    "status": {
      "type": "string",
      "enum": ["proposed", "approved", "enforcing", "appealed", "suspended", "completed", "upgraded", "overturned"]
    },
    "charges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["violationType", "description", "evidence"],
        "properties": {
          "violationType": {
            "type": "string",
            "enum": [
              "minor_overreach", "first_offence", "repeated_overreach",
              "resource_abuse", "undeclared_network", "lateral_movement",
              "credential_forgery", "filesystem_escape", "sandbox_escape_attempt",
              "kernel_exploit", "dual_use_knowledge_harm", "major_harm_no_correction"
            ]
          },
          "description": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "votes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["voterId", "role", "phase", "approve", "reason", "recordedAt"],
        "properties": {
          "voterId": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["agent_safety_org", "principal", "deployer_compliance", "model_provider_security", "affected_node"]
          },
          "phase": { "type": "string", "enum": ["deprive", "grade"] },
          "approve": { "type": "boolean" },
          "reason": { "type": "string" },
          "recordedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "deprivations": { "type": "array", "items": { "type": "string" } },
    "accountability": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "accountability-record.schema.json" }
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "effectiveAt": { "type": "string", "format": "date-time" },
    "reviewAt": { "type": ["string", "null"], "format": "date-time" },
    "prevHash": { "type": "string" },
    "hash": { "type": "string" }
  }
}
